{
  "name": "athenaphone",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .ts,.tsx",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/integration && tsc --noEmit -p test/athenasip",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" App.tsx index.js",
    "test:watch": "jest --watch",
    "check": "npm run typecheck && npm run lint && npm test",
    "postinstall": "patch-package",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:athenasip": "scripts/test-athenasip.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "buffer": "^6.0.3",
    "jssip": "^3.13.8",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-background-timer": "^2.4.1",
    "react-native-callkeep": "^4.3.16",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-incall-manager": "^4.3.0",
    "react-native-keychain": "^10.0.0",
    "react-native-permissions": "^5.6.2",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-udp": "^4.1.7",
    "react-native-webrtc": "^124.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "description": "An open source, fully featured SIP softphone with video calling, built with React Native.",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "sip",
    "voip",
    "softphone",
    "webrtc",
    "react-native",
    "video-calling",
    "jssip"
  ],
  "author": "Tom Cully <mail@tomcully.com>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/blackravenltd/athenaphone.git"
  }
}
