<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon, used from API 26 up. Both layers are vectors, so nothing is
  rasterised here: the launcher masks them to whatever shape it prefers.

  The PNGs in the density-specific mipmap folders exist only for API 24-25,
  which predate adaptive icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
