# Copy to .env and set to the address the phone reaches this server on.
#
#   Simulator or emulator on this machine : 127.0.0.1
#   Physical device on the LAN            : this machine's LAN IP
#
# Asterisk puts this in SDP and Contact, so getting it wrong gives you
# one-way audio or no audio at all -- the classic SIP-behind-NAT symptom.
ASTERISK_EXTERNAL_IP=127.0.0.1
