# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---------------------------------------------------------------- AthenaPhone

# CodeGraph index. Rebuilt locally with `codegraph index`.
.codegraph/

# Local SIP credentials and provisioning used during development. Never commit
# a working account: these files hold real PBX passwords.
*.local.json
provisioning.json
.env
.env.*
!.env.example

# Signing material. Release keys belong in CI secrets, not the repo.
android/app/*.jks
android/keystore.properties
ios/*.mobileprovision
ios/*.p12

# Native build output not already covered above
android/.cxx/
android/app/.cxx/
ios/build/
ios/Podfile.lock.local

# Editor / tooling
.vscode/
*.swp
*.log

# Jest + coverage artefacts
coverage/
junit.xml

# Test fixture TLS material. Generated by test/asterisk/scripts/generate-certs.sh;
# these are private keys and must never be committed, however throwaway.
test/asterisk/tls/
test/asterisk/.env
